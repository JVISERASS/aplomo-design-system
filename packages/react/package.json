{
  "name": "@jviserass/aplomo",
  "version": "0.2.1",
  "description": "Aplomo design system — componentes React sobrios, guiados por tipografía.",
  "type": "module",
  "license": "MIT",
  "author": "JVISERASS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JVISERASS/aplomo-design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/JVISERASS/aplomo-design-system#readme",
  "bugs": {
    "url": "https://github.com/JVISERASS/aplomo-design-system/issues"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "ui",
    "aplomo"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/aplomo.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "gen:barrel": "node scripts/gen-barrel.mjs",
    "build:js": "tsup",
    "build:css": "node ../tokens/scripts/build-css.mjs && node scripts/copy-tokens.mjs",
    "build": "npm run gen:barrel && npm run build:js && npm run build:css && npm run build:umd && npm run build:kits",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build",
    "build:umd": "node scripts/build-umd.mjs",
    "build:kits": "node scripts/build-kits.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^28.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
