{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/assistant/**",
              "components/charts/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/motion/**",
              "components/navigation/**",
              "ui_kits/access/**",
              "ui_kits/account/**",
              "ui_kits/admin/**",
              "ui_kits/assistant/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Recursive|Stack Sans Notch))/i]",
        "message": "Font not provided by the design system. Available: Recursive, Stack Sans Notch."
      },
      {
        "selector": "JSXOpeningElement[name.name='Accordion'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|defaultOpen|key|ref|className|style|children)$/]",
        "message": "<Accordion> doesn't accept that prop. Declared props: items, defaultOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:topbar|nav|aside|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: topbar, nav, aside."
      },
      {
        "selector": "JSXOpeningElement[name.name='AsciiDiagram'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|tone|children|key|ref|className|style|children)$/]",
        "message": "<AsciiDiagram> doesn't accept that prop. Declared props: label, size, tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='AsciiDiagram'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|muted)$/]",
        "message": "<AsciiDiagram> tone must be one of 'default' | 'muted'."
