{
  "name": "aplomo-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo de Aplomo — tokens, librería React y librería Angular.",
  "license": "MIT",
  "author": "JVISERASS",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JVISERASS/aplomo-design-system.git"
  },
  "workspaces": [
    "packages/tokens",
    "packages/react",
    "packages/angular",
    "apps/*"
  ],
  "scripts": {
    "build:tokens": "npm run build -w @jviserass/aplomo-tokens",
    "build:react": "npm run build -w @jviserass/aplomo",
    "build:angular": "npm run build -w @jviserass/aplomo-angular",
    "build": "npm run build:tokens && npm run build:react && npm run build:angular",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "parity": "node scripts/parity-check.mjs",
    "storybook:react": "npm run storybook -w @jviserass/aplomo",
    "storybook:angular": "npm run storybook -w @jviserass/aplomo-angular"
  }
}
