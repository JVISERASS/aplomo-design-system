{
  "name": "aplomo-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo de Aplomo \u2014 tokens, librer\u00eda React y librer\u00eda Angular.",
  "license": "MIT",
  "author": "JVISERASS",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JVISERASS/aplomo-design-system.git"
  },
  "workspaces": [
    "packages/tokens",
    "packages/react",
    "packages/angular",
    "apps/demo-react"
  ],
  "scripts": {
    "build:tokens": "npm run build -w @jviserass/aplomo-tokens",
    "build:react": "npm run build -w @jviserass/aplomo",
    "build:angular": "npm run build -w @jviserass/aplomo-angular",
    "build": "npm run gen:icons && npm run build:tokens && npm run build:react && npm run build:angular",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "parity": "node scripts/parity-check.mjs",
    "storybook:react": "npm run storybook -w @jviserass/aplomo",
    "storybook:angular": "npm run storybook -w @jviserass/aplomo-angular",
    "smoke:angular": "node scripts/smoke-angular.mjs",
    "supply-chain": "node scripts/supply-chain-check.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "stories": "node scripts/stories-check.mjs"
  },
  "devDependencies": {
    "lucide": "^1.31.0"
  }
}
